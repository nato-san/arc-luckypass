# Arc LuckyPass — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# WalletConnect / Reown Project ID
# Get one free at https://cloud.reown.com
# Required for WalletConnect QR / deep-link support.
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Optional: Circle Developer API (for self-deploy workflow only)
# Not needed to run the frontend or interact with the deployed contract.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=

# ── Mainnet deployment (set VITE_CHAIN=mainnet to activate) ──────────────────
# Omit or leave blank to use Testnet (default).
VITE_CHAIN=
VITE_LUCKY_PASS_ADDRESS_MAINNET=
VITE_DEPLOY_BLOCK_MAINNET=
